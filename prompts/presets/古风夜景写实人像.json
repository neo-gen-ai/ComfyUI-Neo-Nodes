{
  "text": "\u753b\u9762\u98ce\u683c\uff1a\u53e4\u98ce\u591c\u666f\u5199\u5b9e\u4eba\u50cf\u6444\u5f71\uff0c\u91c7\u7528\u7535\u5f71\u7ea7\u5149\u5f71\u8d28\u611f\uff0c\u6574\u4f53\u6c1b\u56f4\u6e05\u51b7\u534e\u8d35\uff0c\u8272\u8c03\u4ee5\u9ed1\u91d1\u8272\u4e3a\u4e3b\uff0c\u642d\u914d\u591c\u665a\u7684\u5e7d\u84dd\u4e0e\u6696\u9ec4\u706f\u5149\uff0c\u8425\u9020\u51fa\u53e4\u5178\u5bab\u5ef7\u7684\u6c1b\u56f4\u611f\u3002 \u6838\u5fc3\u5143\u7d20\uff1a\u8eab\u7740\u9ed1\u91d1\u53e4\u98ce\u957f\u88d9\u7684\u5e74\u8f7b\u4e1c\u4e9a\u5973\u6027\uff0c\u7acb\u4e8e\u4e2d\u5f0f\u56ed\u6797\u591c\u666f\u4e2d\uff0c\u80cc\u666f\u6709\u6ee1\u6708\u3001\u53e4\u5efa\u3001\u706f\u7b3c\u4e0e\u7ea2\u53f6\uff0c\u6574\u4f53\u6784\u56fe\u5bf9\u79f0\u5e84\u91cd\uff0c\u4eba\u7269\u4e3a\u753b\u9762\u4e2d\u5fc3\uff0c\u670d\u9970\u4e0e\u73af\u5883\u5143\u7d20\u5f3a\u5316\u4e86\u53e4\u5178\u7f8e\u4eba\u7684\u4e3b\u9898\u3002 \u5177\u4f53\u5185\u5bb9\uff1a\u753b\u9762\u4e2d\u7684\u5973\u6027\u6709\u7740\u4e4c\u9ed1\u957f\u53d1\uff0c\u68b3\u6210\u7cbe\u81f4\u7684\u53e4\u98ce\u53d1\u9afb\uff0c\u4f69\u6234\u91d1\u8272\u53d1\u9970\u4e0e\u6d41\u82cf\u8033\u9970\uff0c\u989d\u95f4\u70b9\u7f00\u82b1\u94bf\uff0c\u5986\u5bb9\u6e05\u4e3d\uff0c\u773c\u795e\u6c89\u9759\uff0c\u8eab\u7740\u4e00\u4ef6\u9ed1\u8272\u62b9\u80f8\u957f\u88d9\uff0c\u88d9\u8eab\u9970\u6709\u7e41\u590d\u7684\u91d1\u8272\u4e91\u7eb9\u523a\u7ee3\uff0c\u642d\u914d\u91d1\u8272\u8170\u5e26\u4e0e\u4e1d\u5e26\uff0c\u5916\u642d\u9ed1\u8272\u8584\u7eb1\u5e7f\u8896\uff0c\u88d9\u6446\u9ad8\u5f00\u53c9\u8bbe\u8ba1\u9732\u51fa\u817f\u90e8\uff0c\u811a\u7a7f\u91d1\u8272\u53e4\u98ce\u51c9\u978b\uff0c\u59ff\u6001\u4f18\u96c5\u5730\u7acb\u4e8e\u77f3\u677f\u8def\u4e0a\u3002\u80cc\u666f\u662f\u591c\u665a\u7684\u4e2d\u5f0f\u56ed\u6797\uff0c\u5de6\u4fa7\u6709\u98de\u6a90\u53e4\u5efa\uff0c\u53f3\u4fa7\u6709\u77f3\u706f\u7b3c\u4e0e\u7ea2\u67ab\u6811\u679d\uff0c\u5929\u7a7a\u60ac\u6302\u7740\u4e00\u8f6e\u6ee1\u6708\uff0c\u5730\u9762\u6563\u843d\u7740\u7ea2\u53f6\uff0c\u706f\u7b3c\u6563\u53d1\u51fa\u6696\u9ec4\u8272\u7684\u5149\u6655\uff0c\u4e0e\u6e05\u51b7\u7684\u6708\u5149\u5f62\u6210\u5bf9\u6bd4\u3002 \u6784\u56fe\u65b9\u5f0f\uff1a\u91c7\u7528\u4e2d\u5fc3\u5bf9\u79f0\u6784\u56fe\uff0c\u4eba\u7269\u4f4d\u4e8e\u753b\u9762\u6b63\u4e2d\u592e\uff0c\u6210\u4e3a\u89c6\u89c9\u7126\u70b9\uff0c\u524d\u666f\u4e3a\u77f3\u677f\u8def\u4e0e\u4eba\u7269\u7684\u88d9\u6446\uff0c\u4e2d\u666f\u4e3a\u4eba\u7269\u4e3b\u4f53\uff0c\u8fdc\u666f\u4e3a\u53e4\u5efa\u3001\u6811\u6728\u4e0e\u6ee1\u6708\uff0c\u5f62\u6210\u7531\u8fd1\u53ca\u8fdc\u7684\u7a7a\u95f4\u5c42\u6b21\u3002\u5149\u5f71\u91c7\u7528\u4fa7\u9006\u5149\uff0c\u6708\u5149\u4e0e\u706f\u7b3c\u7684\u6696\u5149\u4ea4\u7ec7\uff0c\u52fe\u52d2\u51fa\u4eba\u7269\u7684\u8f6e\u5ed3\u4e0e\u670d\u9970\u7684\u7eb9\u7406\uff0c\u6574\u4f53\u5149\u5f71\u8fc7\u6e21\u67d4\u548c\uff0c\u7a81\u51fa\u4eba\u7269\u7684\u6e05\u51b7\u6c14\u8d28\u4e0e\u670d\u9970\u7684\u534e\u8d35\u8d28\u611f\u3002\u76f8\u673a\u53c2\u6570\u8bbe\u5b9a\u4e3a\u5168\u753b\u5e45\u4f20\u611f\u5668\uff0c\u4f7f\u7528 85mm \u5b9a\u7126\u955c\u5934\uff0c\u5149\u5708 f/1.8\uff0c\u5feb\u95e8\u901f\u5ea6 1/125 \u79d2\uff0cISO 100\uff0c\u767d\u5e73\u8861\u504f\u51b7\u8272\u8c03\uff0c\u5bf9\u7126\u6a21\u5f0f\u4e3a\u5355\u70b9\u5bf9\u7126\uff0c\u786e\u4fdd\u4eba\u7269\u9762\u90e8\u4e0e\u670d\u9970\u7ec6\u8282\u6e05\u6670\u9510\u5229\u3002"
}