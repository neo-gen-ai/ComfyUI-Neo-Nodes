{
  "text": "\u4e9a\u6d32\u5973\u751f\uff0c''\u6b64\u5f20\u5168\u666f\u5168\u8eab\u7167\u5c55\u73b0\u4e86\u72ec\u7279\u7684\u4e2d\u56fd\u4f20\u7edf\u98ce\u97f5\u3002\u65b0\u5e74\u4e4b\u9645\uff0c\u5973\u5b50\u8eab\u7740\u7ad6\u9886\u5bf9\u895f\u7684\u8884\u88d9\uff0c\u5176\u8bbe\u8ba1\u7075\u611f\u6e90\u4e8e\u660e\u4e2d\u671f\u670d\u9970\uff0c\u4ee5\u4e2d\u56fd\u7ea2\u8272\u4e3a\u4e3b\u8c03\uff0c\u9970\u4ee5\u4e2d\u56fd\u4f20\u7edf\u7eb9\u6837\uff0c\u5982\u8774\u8776\u7eb9\u548c\u4e8b\u4e8b\u5982\u610f\u7eb9\u7b49\u3002\u7cbe\u81f4\u7684\u7ee3\u7ebf\u52fe\u52d2\u51fa\u901a\u80a9\u8955\uff0c\u7a81\u663e\u4e86\u660e\u4ee3\u670d\u9970\u7684\u7ec6\u817b\u4e0e\u5e84\u91cd\u3002\u88d9\u88c5\u4e3a\u7eff\u8272\u9a6c\u9762\u88d9\uff0c\u5e95\u7eb9\u4ee5\u4e94\u846b\u82a6\u56db\u6d77\u87ba\u8c61\u5f81\u548c\u8c10\u5171\u5904\u3002\u88d9\u8955\u5219\u4ee5\u8c37\u7a57\u3001\u8702\u3001\u5bab\u706f\u7b49\u5143\u7d20\u7ec4\u6210\u7684\u7eb9\u6837\u4e3a\u88c5\u9970\uff0c\u5bd3\u610f\u65b0\u5e74\u559c\u5e86\u4e0e\u7965\u548c\u3002\u5973\u5b50\u624b\u6301\u4e2d\u5f0f\u957f\u6b3e\u7ea2\u706f\u7b3c\uff0c\u4ee5\u8d85\u9ad8\u6e05\u50cf\u7d20\u5c55\u793a\uff0c\u9762\u5e26\u5fae\u7b11\uff0c\u5c3d\u663e\u4e1c\u65b9\u4e4b\u7f8e\u3002''"
}