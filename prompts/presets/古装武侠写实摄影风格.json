{
  "text": "\u753b\u9762\u98ce\u683c\uff1a\u53e4\u88c5\u6b66\u4fa0\u5199\u5b9e\u6444\u5f71\u98ce\u683c\uff0c\u7535\u5f71\u7ea7\u5149\u5f71\u8d28\u611f\uff0c\u67d4\u548c\u81ea\u7136\u5149\u6548\uff0c\u7ec6\u8282\u4e30\u5bcc\uff0c\u5177\u6709\u5f3a\u70c8\u7684\u620f\u5267\u5f20\u529b\u4e0e\u6e05\u51b7\u6c1b\u56f4\u611f\u3002\u6838\u5fc3\u5143\u7d20\uff1a\u53e4\u88c5\u4ed9\u4fa0\u9898\u6750\u573a\u666f\uff0c\u8eab\u7740\u767d\u8272\u53e4\u88c5\u7684\u5973\u6027\u89d2\u8272\uff0c\u8eab\u5904\u4e00\u7fa4\u8eab\u7740\u6d45\u7070\u8272\u53e4\u88c5\u3001\u80cc\u8d1f\u957f\u5251\u7684\u7537\u6027\u89d2\u8272\u4e4b\u4e2d\uff0c\u80cc\u666f\u4e3a\u6a21\u7cca\u7684\u53e4\u4ee3\u5efa\u7b51\u73af\u5883\uff0c\u6574\u4f53\u6c1b\u56f4\u8083\u6740\u6e05\u51b7\uff0c\u5145\u6ee1\u6545\u4e8b\u5f20\u529b\u3002\u5177\u4f53\u5185\u5bb9\uff1a\u753b\u9762\u4e2d\u5fc3\u7684\u5973\u6027\u89d2\u8272\u8eab\u7740\u7eaf\u767d\u8272\u4ea4\u9886\u5e7f\u8896\u53e4\u88c5\uff0c\u8863\u6599\u5782\u5760\u611f\u5f3a\uff0c\u8170\u95f4\u7cfb\u7740\u6d45\u8272\u8170\u5e26\uff0c\u9ed1\u8272\u957f\u53d1\u68b3\u6210\u9ad8\u9afb\uff0c\u4f69\u6234\u7cbe\u81f4\u7684\u91d1\u8272\u53d1\u51a0\u4e0e\u6b65\u6447\uff0c\u8033\u95f4\u5782\u6302\u7740\u91d1\u8272\u6d41\u82cf\u8033\u5760\uff0c\u8138\u988a\u4e0e\u5634\u89d2\u5e26\u6709\u8840\u8ff9\uff0c\u773c\u795e\u6e05\u51b7\u575a\u5b9a\uff0c\u6b63\u89c6\u955c\u5934\uff0c\u8868\u60c5\u5e73\u9759\u800c\u758f\u79bb\u3002\u5979\u8eab\u540e\u659c\u80cc\u7740\u4e00\u628a\u9ed1\u8272\u957f\u5251\uff0c\u5251\u9798\u5e26\u6709\u91d1\u8272\u7eb9\u9970\uff0c\u663e\u5f97\u82f1\u6c14\u5341\u8db3\u3002\u5468\u56f4\u7684\u7537\u6027\u89d2\u8272\u5747\u80cc\u5bf9\u955c\u5934\uff0c\u8eab\u7740\u6d45\u7070\u8272\u6216\u7c73\u767d\u8272\u53e4\u88c5\uff0c\u5934\u53d1\u675f\u6210\u9ad8\u9afb\uff0c\u540c\u6837\u80cc\u8d1f\u957f\u5251\uff0c\u5f62\u6210\u5305\u56f4\u4e4b\u52bf\uff0c\u80cc\u666f\u7684\u5efa\u7b51\u4e0e\u6811\u6728\u88ab\u865a\u5316\u5904\u7406\uff0c\u7a81\u51fa\u4e2d\u5fc3\u4eba\u7269\u7684\u4e3b\u4f53\u5730\u4f4d\u3002\u5149\u5f71\u4e3a\u67d4\u548c\u7684\u81ea\u7136\u5149\uff0c\u4ece\u4fa7\u524d\u65b9\u7167\u5c04\uff0c\u52fe\u52d2\u51fa\u4eba\u7269\u8f6e\u5ed3\uff0c\u9762\u90e8\u5149\u5f71\u8fc7\u6e21\u81ea\u7136\uff0c\u65e0\u660e\u663e\u786c\u8fb9\uff0c\u6574\u4f53\u8272\u8c03\u504f\u51b7\uff0c\u7a81\u51fa\u8083\u6740\u7684\u6c1b\u56f4\u3002\u6784\u56fe\u65b9\u5f0f\uff1a\u91c7\u7528\u5bf9\u79f0\u5f0f\u6784\u56fe\uff0c\u4eba\u7269\u4f4d\u4e8e\u753b\u9762\u4e2d\u5fc3\uff0c\u5468\u56f4\u7684\u7537\u6027\u89d2\u8272\u5f62\u6210\u5411\u5fc3\u5f0f\u6784\u56fe\uff0c\u5c06\u89c6\u7ebf\u805a\u7126\u4e8e\u4e2d\u5fc3\u7684\u5973\u6027\u89d2\u8272\uff0c\u524d\u666f\u4e0e\u4e2d\u666f\u4e3a\u7537\u6027\u89d2\u8272\u7684\u80cc\u5f71\uff0c\u80cc\u666f\u4e3a\u865a\u5316\u7684\u53e4\u4ee3\u5efa\u7b51\uff0c\u589e\u5f3a\u753b\u9762\u7684\u7eb5\u6df1\u611f\u4e0e\u6c1b\u56f4\u611f\u3002\u76f8\u673a\u53c2\u6570\u8bbe\u5b9a\u4e3a\u5168\u753b\u5e45\u4f20\u611f\u5668\uff0c\u4f7f\u7528 85mm \u5b9a\u7126\u955c\u5934\uff0c\u5149\u5708 f/2.8\uff0c\u5feb\u95e8\u901f\u5ea6 1/200 \u79d2\uff0cISO 100\uff0c\u767d\u5e73\u8861\u504f\u51b7\u8272\u8c03\uff0c\u5bf9\u7126\u6a21\u5f0f\u4e3a\u5355\u70b9\u5bf9\u7126\uff0c\u786e\u4fdd\u4e2d\u5fc3\u4eba\u7269\u7684\u9762\u90e8\u4e0e\u670d\u88c5\u7ec6\u8282\u6e05\u6670\u9510\u5229\u3002\u5149\u7ebf\u6765\u81ea\u4fa7\u524d\u65b9\uff0c\u5f62\u6210\u67d4\u548c\u7684\u4fa7\u5149\u6548\u679c\uff0c\u7a81\u51fa\u4eba\u7269\u9762\u90e8\u7684\u8f6e\u5ed3\u4e0e\u670d\u88c5\u7684\u7eb9\u7406\u7ec6\u8282\uff0c\u6574\u4f53\u8272\u5f69\u57fa\u8c03\u4ee5\u767d\u8272\u3001\u7070\u8272\u4e0e\u9ed1\u8272\u4e3a\u4e3b\uff0c\u8425\u9020\u51fa\u6e05\u51b7\u8083\u6740\u7684\u53e4\u88c5\u6b66\u4fa0\u6c1b\u56f4\u3002"
}