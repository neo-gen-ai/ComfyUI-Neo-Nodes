{
  "text": "\u753b\u9762\u98ce\u683c\uff1a\u56fd\u98ce\u53e4\u88c5\u4eba\u50cf\u6444\u5f71\uff0c\u9ad8\u5206\u8fa8\u7387\u9ad8\u6e05\u6670\u5ea6\uff0c\u5149\u5f71\u67d4\u548c\u901a\u900f\uff0c\u8272\u5f69\u6d53\u90c1\u5178\u96c5\uff0c\u6574\u4f53\u6c1b\u56f4\u534e\u8d35\u5927\u6c14\uff0c\u5e26\u6709\u53e4\u5178\u5bab\u5ef7\u6c1b\u56f4\u611f\u3002\u6838\u5fc3\u5143\u7d20\uff1a\u5e74\u8f7b\u7684\u4e1c\u4e9a\u5973\u6027\uff0c\u8eab\u7740\u7ea2\u8272\u523a\u7ee3\u53e4\u98ce\u793c\u670d\uff0c\u80cc\u666f\u4e3a\u53e4\u98ce\u5efa\u7b51\u4e0e\u84dd\u5929\uff0c\u4eba\u7269\u4f4d\u4e8e\u753b\u9762\u4e2d\u5fc3\u4f4d\u7f6e\uff0c\u91c7\u7528\u7ad6\u7248\u8fd1\u666f\u6784\u56fe\uff0c\u524d\u666f\u4e3a\u4eba\u7269\u624b\u90e8\uff0c\u4e2d\u666f\u4e3a\u4eba\u7269\u4e3b\u4f53\uff0c\u80cc\u666f\u4e3a\u865a\u5316\u7684\u53e4\u98ce\u5efa\u7b51\u8f6e\u5ed3\uff0c\u8425\u9020\u51fa\u5c42\u6b21\u4e30\u5bcc\u7684\u7eb5\u6df1\u611f\u3002\u5177\u4f53\u5185\u5bb9\uff1a\u5973\u6027\u62e5\u6709\u4e4c\u9ed1\u7684\u76d8\u53d1\u9020\u578b\uff0c\u53d1\u9afb\u4e0a\u4f69\u6234\u7740\u91d1\u8272\u51e4\u51f0\u53d1\u51a0\uff0c\u642d\u914d\u6d41\u82cf\u989d\u9970\u4e0e\u6b65\u6447\uff0c\u6d41\u82cf\u5782\u843d\uff0c\u53d1\u4e1d\u88ab\u98ce\u5439\u8d77\uff0c\u5e26\u6709\u81ea\u7136\u7684\u98d8\u9038\u611f\u3002\u5979\u7684\u4e94\u5b98\u7cbe\u81f4\u51b7\u8273\uff0c\u76ae\u80a4\u767d\u7699\u901a\u900f\uff0c\u773c\u795e\u660e\u4eae\u6e05\u6f88\uff0c\u76f4\u89c6\u955c\u5934\uff0c\u8868\u60c5\u6e29\u5a49\u7aef\u5e84\u3002\u8eab\u7740\u7ea2\u8272\u62b9\u80f8\u53e4\u98ce\u793c\u670d\uff0c\u8863\u8eab\u5e03\u6ee1\u91d1\u8272\u51e4\u51f0\u4e0e\u82b1\u5349\u523a\u7ee3\u7eb9\u6837\uff0c\u8896\u53e3\u5bbd\u5927\u98d8\u9038\uff0c\u9762\u6599\u5e26\u6709\u7ec6\u817b\u7684\u7eb9\u7406\u5149\u6cfd\uff0c\u8170\u95f4\u7cfb\u6709\u91d1\u8272\u8170\u5e26\uff0c\u6574\u4f53\u9020\u578b\u534e\u8d35\u5927\u6c14\u3002\u5979\u53cc\u624b\u8f7b\u63e1\u7f6e\u4e8e\u80f8\u524d\uff0c\u59ff\u6001\u4f18\u96c5\uff0c\u80cc\u666f\u662f\u865a\u5316\u7684\u53e4\u98ce\u5efa\u7b51\u8f6e\u5ed3\u4e0e\u6f84\u6f88\u7684\u84dd\u5929\uff0c\u5149\u7ebf\u4e3a\u4fa7\u524d\u65b9\u7684\u81ea\u7136\u5149\uff0c\u52fe\u52d2\u51fa\u4eba\u7269\u7684\u8f6e\u5ed3\u5149\uff0c\u6574\u4f53\u5149\u5f71\u8fc7\u6e21\u81ea\u7136\u3002\u6784\u56fe\u65b9\u5f0f\uff1a\u7ad6\u7248\u8fd1\u666f\u4eba\u50cf\u6784\u56fe\uff0c\u4eba\u7269\u4f4d\u4e8e\u753b\u9762\u4e2d\u5fc3\uff0c\u91c7\u7528\u4e09\u5206\u6cd5\u6784\u56fe\uff0c\u524d\u666f\u7684\u624b\u90e8\u52a8\u4f5c\u4e0e\u670d\u9970\u7ec6\u8282\u5f62\u6210\u89c6\u89c9\u5f15\u5bfc\uff0c\u4e2d\u666f\u4eba\u7269\u4e3a\u89c6\u89c9\u7126\u70b9\uff0c\u80cc\u666f\u7684\u865a\u5316\u73af\u5883\u7a81\u51fa\u4e3b\u4f53\u3002\u76f8\u673a\u53c2\u6570\u4e3a\u5168\u753b\u5e45\u4f20\u611f\u5668\uff0c\u4f7f\u7528 85mm \u5b9a\u7126\u955c\u5934\uff0c\u5149\u5708 f/1.8\uff0c\u5feb\u95e8\u901f\u5ea6 1/200 \u79d2\uff0cISO 100\uff0c\u5bf9\u7126\u6a21\u5f0f\u4e3a\u5355\u70b9\u5bf9\u7126\uff0c\u786e\u4fdd\u4eba\u7269\u9762\u90e8\u4e0e\u670d\u9970\u523a\u7ee3\u7ec6\u8282\u6e05\u6670\u9510\u5229\u3002\u5149\u7ebf\u4e3a\u660e\u4eae\u7684\u6563\u5c04\u81ea\u7136\u5149\uff0c\u9634\u5f71\u8fc7\u6e21\u67d4\u548c\uff0c\u6574\u4f53\u8272\u5f69\u57fa\u8c03\u4ee5\u6b63\u7ea2\u8272\u3001\u91d1\u8272\u4e0e\u84dd\u8272\u4e3a\u4e3b\uff0c\u8425\u9020\u51fa\u534e\u8d35\u5927\u6c14\u7684\u53e4\u5178\u5bab\u5ef7\u6c1b\u56f4\u3002"
}