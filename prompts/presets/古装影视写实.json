{
  "text": "\u753b\u9762\u98ce\u683c\uff1a\u53e4\u88c5\u6b66\u4fa0\u5199\u5b9e\u6444\u5f71\u98ce\u683c\uff0c\u7535\u5f71\u7ea7\u5149\u5f71\u8d28\u611f\uff0c\u51b7\u8272\u8c03\u6c1b\u56f4\u611f\uff0c\u7ec6\u8282\u4e30\u5bcc\uff0c\u5177\u6709\u5f3a\u70c8\u7684\u620f\u5267\u5f20\u529b\u4e0e\u6c5f\u6e56\u8083\u6740\u611f\u3002\u6838\u5fc3\u5143\u7d20\uff1a\u53e4\u88c5\u6b66\u4fa0\u9898\u6750\u573a\u666f\uff0c\u53e4\u4ee3\u57ce\u5899\u4e0b\u7684\u5e02\u4e95\u8857\u9053\uff0c\u8eab\u7740\u9ed1\u8272\u52b2\u88c5\u7684\u5e74\u8f7b\u7537\u5973\u89d2\u8272\u5e76\u80a9\u800c\u7acb\uff0c\u9762\u5bf9\u524d\u666f\u7684\u4eba\u7269\uff0c\u80cc\u666f\u662f\u53e4\u8001\u7684\u77f3\u780c\u57ce\u5899\u4e0e\u4f20\u7edf\u5efa\u7b51\uff0c\u5468\u56f4\u5206\u5e03\u7740\u8eab\u7740\u53e4\u88c5\u7684\u8def\u4eba\uff0c\u6574\u4f53\u6c1b\u56f4\u7d27\u5f20\u5bf9\u5cd9\uff0c\u5145\u6ee1\u6c5f\u6e56\u6c14\u606f\u3002\u5177\u4f53\u5185\u5bb9\uff1a\u7537\u6027\u89d2\u8272\u8eab\u7740\u6df1\u84dd\u8272\u52b2\u88c5\uff0c\u5916\u62ab\u6df1\u8272\u6597\u7bf7\uff0c\u6597\u7bf7\u88ab\u98ce\u5439\u8d77\uff0c\u8170\u95f4\u7cfb\u7740\u5e26\u6709\u91d1\u5c5e\u5706\u6263\u7684\u5bbd\u7248\u8170\u5e26\uff0c\u624b\u81c2\u4f69\u6234\u7740\u5e26\u6709\u94f6\u8272\u94c6\u9489\u7684\u62a4\u81c2\uff0c\u9ed1\u8272\u957f\u53d1\u675f\u6210\u9ad8\u9afb\uff0c\u989d\u89d2\u4e0e\u8138\u988a\u5e26\u6709\u8840\u8ff9\uff0c\u773c\u795e\u51cc\u5389\uff0c\u8868\u60c5\u51b7\u5cfb\uff0c\u80cc\u4e0a\u659c\u630e\u7740\u4e00\u628a\u9ed1\u8272\u957f\u5251\u3002\u4ed6\u8eab\u65c1\u7684\u5973\u6027\u89d2\u8272\u8eab\u7740\u9ed1\u8272\u77ed\u6253\u52b2\u88c5\uff0c\u8863\u670d\u5e26\u6709\u7cbe\u81f4\u7684\u6697\u7eb9\u88c5\u9970\uff0c\u8170\u95f4\u7cfb\u7740\u540c\u8272\u7cfb\u8170\u5e26\uff0c\u624b\u6301\u4e00\u628a\u77ed\u5203\uff0c\u9ed1\u8272\u957f\u53d1\u675f\u6210\u9ad8\u9a6c\u5c3e\uff0c\u773c\u795e\u9510\u5229\uff0c\u8868\u60c5\u575a\u5b9a\uff0c\u4e0e\u7537\u6027\u89d2\u8272\u5e76\u80a9\u800c\u7acb\uff0c\u59ff\u6001\u6212\u5907\u3002\u80cc\u666f\u662f\u9ad8\u5927\u7684\u77f3\u780c\u57ce\u5899\uff0c\u57ce\u5899\u4e0a\u6709\u579b\u53e3\uff0c\u4e0b\u65b9\u662f\u9752\u77f3\u677f\u94fa\u5c31\u7684\u8857\u9053\uff0c\u4e24\u4fa7\u5206\u5e03\u7740\u6728\u8d28\u7ed3\u6784\u7684\u5efa\u7b51\uff0c\u8fdc\u5904\u7684\u8def\u4eba\u7a7f\u7740\u5404\u8272\u53e4\u88c5\uff0c\u8868\u60c5\u5404\u5f02\uff0c\u6574\u4f53\u573a\u666f\u8fd8\u539f\u4e86\u53e4\u4ee3\u5e02\u4e95\u7684\u98ce\u8c8c\uff0c\u7a7a\u6c14\u4e2d\u5f25\u6f2b\u7740\u6de1\u6de1\u7684\u96fe\u6c14\uff0c\u5149\u5f71\u4e3a\u67d4\u548c\u7684\u81ea\u7136\u5149\uff0c\u4ece\u4fa7\u524d\u65b9\u7167\u5c04\uff0c\u52fe\u52d2\u51fa\u4eba\u7269\u8f6e\u5ed3\uff0c\u9762\u90e8\u5149\u5f71\u8fc7\u6e21\u81ea\u7136\uff0c\u65e0\u660e\u663e\u786c\u8fb9\u3002\u6784\u56fe\u65b9\u5f0f\uff1a\u91c7\u7528\u5bf9\u79f0\u5f0f\u4e2d\u666f\u6784\u56fe\uff0c\u4eba\u7269\u4f4d\u4e8e\u753b\u9762\u4e2d\u5fc3\uff0c\u524d\u666f\u7684\u4eba\u7269\u80cc\u5f71\u5f62\u6210\u89c6\u89c9\u5f15\u5bfc\u7ebf\uff0c\u5c06\u89c6\u7ebf\u5f15\u5411\u4e2d\u5fc3\u7684\u7537\u5973\u4e3b\u89d2\uff0c\u80cc\u666f\u7684\u57ce\u5899\u4e0e\u5efa\u7b51\u7ebf\u6761\u589e\u5f3a\u4e86\u753b\u9762\u7684\u7eb5\u6df1\u611f\uff0c\u524d\u666f\u4e3a\u5bf9\u5cd9\u7684\u53cc\u65b9\uff0c\u4e2d\u666f\u4e3a\u5e76\u80a9\u800c\u7acb\u7684\u7537\u5973\u4e3b\u89d2\uff0c\u8fdc\u666f\u4e3a\u57ce\u5899\u4e0e\u8def\u4eba\uff0c\u6574\u4f53\u6784\u56fe\u7a33\u5b9a\u4e14\u5177\u6709\u5f3a\u70c8\u7684\u5bf9\u5cd9\u5f20\u529b\u3002\u76f8\u673a\u53c2\u6570\u8bbe\u5b9a\u4e3a\u5168\u753b\u5e45\u4f20\u611f\u5668\uff0c\u4f7f\u7528 50mm \u6807\u51c6\u955c\u5934\uff0c\u5149\u5708 f/2.8\uff0c\u5feb\u95e8\u901f\u5ea6 1/125 \u79d2\uff0cISO 100\uff0c\u767d\u5e73\u8861\u504f\u51b7\u8272\u8c03\uff0c\u5bf9\u7126\u6a21\u5f0f\u4e3a\u5355\u70b9\u5bf9\u7126\uff0c\u786e\u4fdd\u4e2d\u5fc3\u4eba\u7269\u7684\u9762\u90e8\u4e0e\u670d\u88c5\u7ec6\u8282\u6e05\u6670\u9510\u5229\u3002\u5149\u7ebf\u6765\u81ea\u4fa7\u524d\u65b9\uff0c\u5f62\u6210\u67d4\u548c\u7684\u4fa7\u5149\u6548\u679c\uff0c\u4eba\u7269\u9762\u90e8\u4e0e\u670d\u88c5\u4e0a\u7684\u5149\u5f71\u5bf9\u6bd4\u5f3a\u70c8\uff0c\u7a81\u51fa\u7d27\u5f20\u7684\u620f\u5267\u6c1b\u56f4\u3002\u6574\u4f53\u8272\u5f69\u57fa\u8c03\u4ee5\u9ed1\u8272\u3001\u6df1\u84dd\u8272\u4e0e\u7070\u8272\u4e3a\u4e3b\uff0c\u8f85\u4ee5\u80cc\u666f\u5efa\u7b51\u7684\u77f3\u7070\u8272\uff0c\u8425\u9020\u51fa\u8083\u6740\u51b7\u5cfb\u7684\u53e4\u88c5\u6b66\u4fa0\u6c1b\u56f4\u3002"
}