{
  "text": "\u753b\u9762\u98ce\u683c\uff1a\u53e4\u88c5\u5f71\u89c6\u5199\u5b9e\u6444\u5f71\u98ce\u683c\uff0c\u7535\u5f71\u7ea7\u52a8\u6001\u6355\u6349\uff0c\u5149\u5f71\u8fc7\u6e21\u81ea\u7136\uff0c\u8272\u5f69\u8fd8\u539f\u771f\u5b9e\u4e14\u5bcc\u6709\u5c42\u6b21\u611f\uff0c\u6574\u4f53\u6c1b\u56f4\u7d27\u5f20\u6025\u4fc3\uff0c\u5177\u6709\u5f3a\u70c8\u7684\u52a8\u611f\u4e0e\u6545\u4e8b\u5f20\u529b\u3002\u6838\u5fc3\u5143\u7d20\uff1a\u53e4\u88c5\u5e02\u4e95\u9898\u6750\u573a\u666f\uff0c\u70ed\u95f9\u7684\u53e4\u4ee3\u8857\u5df7\uff0c\u77f3\u677f\u8def\u4e24\u4fa7\u662f\u5546\u94fa\u4e0e\u644a\u4f4d\uff0c\u8eab\u7740\u53e4\u88c5\u7684\u5e74\u8f7b\u7537\u5973\u89d2\u8272\u624b\u7275\u624b\u5954\u8dd1\uff0c\u8eab\u540e\u6709\u8ffd\u5175\u8ffd\u8d76\uff0c\u80cc\u666f\u662f\u7199\u7199\u6518\u6518\u7684\u53e4\u4ee3\u8def\u4eba\uff0c\u6574\u4f53\u6c1b\u56f4\u5145\u6ee1\u9003\u4ea1\u7684\u7d27\u5f20\u611f\u3002\u5177\u4f53\u5185\u5bb9\uff1a\u7537\u6027\u89d2\u8272\u8eab\u7740\u7d20\u767d\u8272\u5706\u9886\u53e4\u88c5\uff0c\u8170\u95f4\u7cfb\u7740\u7070\u8272\u8170\u5e26\uff0c\u80cc\u7740\u4e00\u4e2a\u7af9\u7f16\u80cc\u7bd3\uff0c\u5934\u53d1\u675f\u6210\u9ad8\u9afb\uff0c\u795e\u60c5\u7d27\u5f20\u6025\u4fc3\uff0c\u5927\u6b65\u5411\u524d\u5954\u8dd1\u3002\u4ed6\u8eab\u65c1\u7684\u5973\u6027\u89d2\u8272\u8eab\u7740\u6a59\u9ec4\u8272\u4ea4\u9886\u8966\u88d9\uff0c\u5916\u642d\u4e00\u4ef6\u6d45\u7eff\u8272\u5e7f\u8896\u7eb1\u886b\uff0c\u8863\u670d\u4e0a\u9970\u6709\u7cbe\u81f4\u7684\u82b1\u7eb9\uff0c\u5934\u53d1\u68b3\u6210\u53cc\u9afb\u5e76\u4f69\u6234\u91d1\u8272\u53d1\u9970\uff0c\u624b\u8155\u6234\u7740\u7389\u956f\uff0c\u795e\u60c5\u614c\u5f20\uff0c\u7d27\u7d27\u6293\u7740\u7537\u6027\u89d2\u8272\u7684\u624b\u81c2\uff0c\u4e24\u4eba\u4e00\u540c\u5411\u524d\u5954\u8dd1\uff0c\u8863\u8882\u56e0\u8dd1\u52a8\u800c\u5927\u5e45\u626c\u8d77\u3002\u4ed6\u4eec\u8eab\u540e\uff0c\u4e00\u540d\u8eab\u7740\u84dd\u8272\u52b2\u88c5\u7684\u7537\u5b50\u624b\u6301\u957f\u5251\u8ffd\u8d76\uff0c\u8868\u60c5\u51f6\u72e0\u3002\u80cc\u666f\u7684\u8857\u5df7\u4e24\u4fa7\u662f\u6728\u8d28\u7ed3\u6784\u7684\u5546\u94fa\uff0c\u644a\u4f4d\u4e0a\u6446\u653e\u7740\u5546\u54c1\uff0c\u8def\u4e0a\u7684\u8def\u4eba\u7a7f\u7740\u5404\u8272\u53e4\u88c5\uff0c\u8868\u60c5\u5404\u5f02\uff0c\u6709\u7684\u60ca\u8bb6\u5730\u770b\u5411\u5954\u8dd1\u7684\u4e24\u4eba\uff0c\u6574\u4f53\u573a\u666f\u8fd8\u539f\u4e86\u53e4\u4ee3\u5e02\u4e95\u7684\u70ed\u95f9\u6c1b\u56f4\uff0c\u77f3\u677f\u8def\u4e0e\u6728\u8d28\u5efa\u7b51\u7ec6\u8282\u6e05\u6670\uff0c\u5149\u5f71\u6765\u81ea\u8857\u5df7\u4e24\u4fa7\u7684\u706f\u7b3c\u4e0e\u81ea\u7136\u5149\uff0c\u6574\u4f53\u8272\u8c03\u504f\u6696\uff0c\u7a81\u51fa\u5e02\u4e95\u7684\u70df\u706b\u6c14\u4e0e\u9003\u4ea1\u7684\u7d27\u5f20\u611f\u3002\u6784\u56fe\u65b9\u5f0f\uff1a\u91c7\u7528\u52a8\u6001\u4e2d\u666f\u6784\u56fe\uff0c\u4eba\u7269\u4f4d\u4e8e\u753b\u9762\u4e2d\u5fc3\uff0c\u4ee5\u5954\u8dd1\u7684\u52a8\u4f5c\u4e3a\u89c6\u89c9\u7126\u70b9\uff0c\u524d\u666f\u4e3a\u5954\u8dd1\u7684\u7537\u5973\u4e3b\u89d2\uff0c\u4e2d\u666f\u4e3a\u8ffd\u8d76\u7684\u8ffd\u5175\u4e0e\u8def\u8fb9\u7684\u644a\u4f4d\uff0c\u8fdc\u666f\u4e3a\u8857\u5df7\u6df1\u5904\u4e0e\u6a21\u7cca\u7684\u8def\u4eba\uff0c\u5229\u7528\u4eba\u7269\u7684\u8dd1\u52a8\u65b9\u5411\u4e0e\u8863\u8882\u626c\u8d77\u7684\u7ebf\u6761\u589e\u5f3a\u753b\u9762\u7684\u52a8\u611f\u4e0e\u5f15\u5bfc\u6027\u3002\u76f8\u673a\u53c2\u6570\u8bbe\u5b9a\u4e3a\u5168\u753b\u5e45\u4f20\u611f\u5668\uff0c\u4f7f\u7528 35mm \u955c\u5934\uff0c\u5149\u5708 f/2.8\uff0c\u5feb\u95e8\u901f\u5ea6 1/500 \u79d2\uff0cISO 100\uff0c\u767d\u5e73\u8861\u81ea\u52a8\uff0c\u5bf9\u7126\u6a21\u5f0f\u4e3a\u8ffd\u7126\u6a21\u5f0f\uff0c\u786e\u4fdd\u5954\u8dd1\u4eba\u7269\u7684\u52a8\u6001\u7ec6\u8282\u6e05\u6670\u9510\u5229\u3002\u5149\u7ebf\u6765\u81ea\u8857\u5df7\u4e0a\u65b9\u7684\u81ea\u7136\u5149\u4e0e\u4e24\u4fa7\u7684\u706f\u7b3c\uff0c\u5f62\u6210\u67d4\u548c\u7684\u4fa7\u5149\u6548\u679c\uff0c\u4eba\u7269\u9762\u90e8\u4e0e\u670d\u88c5\u4e0a\u7684\u5149\u5f71\u8fc7\u6e21\u81ea\u7136\uff0c\u65e0\u660e\u663e\u786c\u8fb9\u3002\u6574\u4f53\u8272\u5f69\u57fa\u8c03\u4ee5\u6696\u8272\u8c03\u4e3a\u4e3b\uff0c\u767d\u8272\u3001\u7eff\u8272\u3001\u6a59\u8272\u7684\u670d\u88c5\u4e0e\u84dd\u8272\u52b2\u88c5\u5f62\u6210\u8272\u5f69\u5bf9\u6bd4\uff0c\u8425\u9020\u51fa\u7d27\u5f20\u53c8\u5145\u6ee1\u70df\u706b\u6c14\u7684\u53e4\u88c5\u9003\u4ea1\u6c1b\u56f4\u3002\n\n"
}