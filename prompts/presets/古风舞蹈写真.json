{
  "text": "\u753b\u9762\u98ce\u683c\uff1a\u6e05\u65b0\u660e\u4eae\u7684\u53e4\u98ce\u821e\u8e48\u5199\u771f\u98ce\u683c\uff0c\u91c7\u7528\u9ad8\u5206\u8fa8\u7387\u4e0e\u67d4\u548c\u7ec6\u817b\u7684\u5149\u5f71\u8fc7\u6e21\u5448\u73b0\uff0c\u8272\u5f69\u8fd8\u539f\u6e05\u65b0\u81ea\u7136\uff0c\u6574\u4f53\u6c1b\u56f4\u7075\u52a8\u4f18\u96c5\uff0c\u5177\u6709\u6c89\u6d78\u5f0f\u7684\u53e4\u5178\u7f8e\u611f\u3002\u6838\u5fc3\u5143\u7d20\uff1a\u5e74\u8f7b\u7684\u4e1c\u4e9a\u5973\u6027\u821e\u8005\uff0c\u8eab\u7740\u6d45\u84dd\u8272\u6566\u714c\u98ce\u53e4\u5178\u821e\u670d\uff0c\u80cc\u666f\u4e3a\u660e\u4eae\u7684\u821e\u8e48\u6559\u5ba4\uff0c\u4eba\u7269\u4f4d\u4e8e\u753b\u9762\u4e2d\u5fc3\u4f4d\u7f6e\uff0c\u6784\u56fe\u91c7\u7528\u4e09\u5206\u6cd5\uff0c\u524d\u666f\u4e3a\u4eba\u7269\u7684\u821e\u978b\u4e0e\u88d9\u6446\uff0c\u4e2d\u666f\u4e3a\u4eba\u7269\u4e3b\u4f53\uff0c\u8fdc\u666f\u4e3a\u865a\u5316\u7684\u6559\u5ba4\u5899\u9762\uff0c\u589e\u5f3a\u7a7a\u95f4\u7eb5\u6df1\u611f\u3002\u5177\u4f53\u5185\u5bb9\uff1a\u5973\u6027\u821e\u8005\u62e5\u6709\u4e4c\u9ed1\u7684\u957f\u53d1\uff0c\u68b3\u6210\u7cbe\u81f4\u7684\u53e4\u5178\u53d1\u9afb\uff0c\u642d\u914d\u91d1\u8272\u4e0e\u7389\u77f3\u88c5\u9970\u7684\u534e\u4e3d\u5934\u9970\uff0c\u989d\u95f4\u70b9\u6709\u7ea2\u8272\u82b1\u94bf\uff0c\u5986\u5bb9\u6e05\u65b0\u6de1\u96c5\uff0c\u773c\u795e\u67d4\u548c\u4e13\u6ce8\uff0c\u8868\u60c5\u6e29\u5a49\u606c\u9759\u3002\u5979\u8eab\u7740\u6d45\u84dd\u8272\u62b9\u80f8\u77ed\u6b3e\u821e\u8863\uff0c\u8863\u8eab\u5e26\u6709\u91d1\u8272\u523a\u7ee3\u4e0e\u7ea2\u8272\u5b9d\u77f3\u88c5\u9970\uff0c\u4e0b\u6446\u7f00\u6709\u767d\u8272\u6d41\u82cf\uff0c\u642d\u914d\u540c\u8272\u7cfb\u6e10\u53d8\u7eb1\u8d28\u957f\u88d9\uff0c\u8170\u95f4\u914d\u6709\u91d1\u8272\u94fe\u6761\u4e0e\u5b9d\u77f3\u88c5\u9970\u7684\u8170\u5c01\uff0c\u6d45\u84dd\u8272\u7684\u7eb1\u8d28\u98d8\u5e26\u4ece\u624b\u81c2\u95f4\u5782\u843d\uff0c\u968f\u98ce\u98d8\u52a8\u3002\u5979\u7684\u52a8\u4f5c\u662f\u53e4\u5178\u821e\u7684\u821e\u59ff\uff0c\u53f3\u817f\u5c48\u819d\u62ac\u8d77\uff0c\u811a\u5c16\u7ef7\u76f4\uff0c\u5de6\u817f\u652f\u6491\u5730\u9762\uff0c\u53cc\u81c2\u81ea\u7136\u8212\u5c55\uff0c\u4e00\u624b\u5728\u80f8\u524d\u505a\u51fa\u5170\u82b1\u6307\u59ff\u6001\uff0c\u53e6\u4e00\u624b\u5411\u5916\u5c55\u5f00\uff0c\u59ff\u6001\u4f18\u96c5\u4e14\u5bcc\u6709\u52a8\u6001\u611f\u3002\u821e\u670d\u7684\u7eb1\u8d28\u9762\u6599\u8f7b\u76c8\u98d8\u9038\uff0c\u5e26\u6709\u7ec6\u5fae\u7684\u95ea\u7c89\u7eb9\u7406\uff0c\u5448\u73b0\u534a\u900f\u660e\u7684\u8d28\u611f\uff0c\u821e\u978b\u4e3a\u6d45\u7c73\u8272\u8f6f\u5e95\u82ad\u857e\u978b\u3002\u80cc\u666f\u4e3a\u660e\u4eae\u7684\u821e\u8e48\u6559\u5ba4\uff0c\u5899\u9762\u4e3a\u6d45\u7070\u8272\uff0c\u5de6\u4fa7\u53ef\u89c1\u6728\u8d28\u628a\u6746\uff0c\u5730\u9762\u4e3a\u5149\u6ed1\u7684\u7070\u8272\u5730\u677f\uff0c\u53cd\u5c04\u51fa\u67d4\u548c\u7684\u5149\u7ebf\uff0c\u6574\u4f53\u73af\u5883\u5e72\u51c0\u7b80\u6d01\uff0c\u7a81\u51fa\u4eba\u7269\u4e3b\u4f53\u3002\u6784\u56fe\u65b9\u5f0f\uff1a\u91c7\u7528\u4e09\u5206\u6cd5\u6784\u56fe\uff0c\u4eba\u7269\u4f4d\u4e8e\u753b\u9762\u4e2d\u5fc3\u504f\u5de6\u4f4d\u7f6e\uff0c\u524d\u666f\u4e3a\u4eba\u7269\u7684\u821e\u978b\u4e0e\u88d9\u6446\uff0c\u4e2d\u666f\u4e3a\u4eba\u7269\u4e3b\u4f53\uff0c\u8fdc\u666f\u4e3a\u865a\u5316\u7684\u6559\u5ba4\u5899\u9762\uff0c\u5f62\u6210\u81ea\u7136\u7684\u89c6\u89c9\u52a8\u7ebf\u3002\u76f8\u673a\u53c2\u6570\u8bbe\u5b9a\u4e3a\u5168\u753b\u5e45\u4f20\u611f\u5668\uff0c\u4f7f\u7528 50mm \u5b9a\u7126\u955c\u5934\uff0c\u5149\u5708 f/2.8\uff0c\u5feb\u95e8\u901f\u5ea6 1/160 \u79d2\uff0cISO 100\uff0c\u5bf9\u7126\u6a21\u5f0f\u4e3a\u5355\u70b9\u5bf9\u7126\uff0c\u786e\u4fdd\u4eba\u7269\u9762\u90e8\u4e0e\u821e\u670d\u7ec6\u8282\u6e05\u6670\u9510\u5229\uff0c\u80cc\u666f\u5904\u4e8e\u67d4\u7126\u865a\u5316\u72b6\u6001\u3002\u5149\u7ebf\u6765\u81ea\u524d\u65b9\uff0c\u5f62\u6210\u67d4\u548c\u7684\u987a\u5149\u6548\u679c\uff0c\u8f85\u4ee5\u8f7b\u5fae\u7684\u4fa7\u9006\u5149\uff0c\u52fe\u52d2\u51fa\u4eba\u7269\u53d1\u4e1d\u4e0e\u821e\u670d\u8fb9\u7f18\u7684\u8f6e\u5ed3\uff0c\u9634\u5f71\u8fc7\u6e21\u81ea\u7136\uff0c\u9ad8\u5149\u96c6\u4e2d\u5728\u821e\u670d\u7684\u7eb1\u8d28\u9762\u6599\u4e0e\u4eba\u7269\u76ae\u80a4\uff0c\u6574\u4f53\u8272\u5f69\u57fa\u8c03\u4ee5\u6d45\u84dd\u8272\u4e0e\u767d\u8272\u4e3a\u4e3b\uff0c\u8f85\u4ee5\u91d1\u8272\u4e0e\u7ea2\u8272\u70b9\u7f00\uff0c\u8425\u9020\u51fa\u6e05\u65b0\u7075\u52a8\u7684\u53e4\u5178\u6c1b\u56f4\u3002"
}